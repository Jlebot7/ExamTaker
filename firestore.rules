rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ====================================================================
       1. EXÁMENES PÚBLICOS (/exams/{examId})
       - Contiene: Título, preguntas, opciones de respuesta, tiempo límite y puntos.
       - Aislamiento Zero-Leak: NUNCA contiene las respuestas correctas.
       - Lectura: Permitida si el examen está publicado o al docente creador.
       - Escritura: Exclusiva del docente creador.
       ==================================================================== */
    match /exams/{examId} {
      allow read: if resource == null || resource.data.isPublished == true || (
        request.auth != null && resource.data.createdBy == request.auth.uid
      );
      
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;

      /* ====================================================================
         2. ENVÍOS Y RESPUESTAS (/exams/{examId}/submissions/{studentUid})
         - Contiene: Respuestas seleccionadas en tiempo real, hora de inicio,
           infracciones acumuladas y estado.
         - Lectura: El alumno lee su propio intento; el docente lee los de su examen.
         - Escritura: El alumno crea su intento y actualiza respuestas mientras
           esté 'in_progress'; el docente puede calificar.
         ==================================================================== */
      match /submissions/{studentUid} {
        allow read: if request.auth != null && (
          request.auth.uid == studentUid ||
          get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid
        );

        allow create: if request.auth != null &&
          request.auth.uid == studentUid;

        allow update: if request.auth != null && (
          (request.auth.uid == studentUid && (
            resource.data.status == 'in_progress' ||
            request.resource.data.status in ['submitted', 'timed_out', 'disqualified']
          )) ||
          get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid
        );

        allow delete: if request.auth != null &&
          get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid;

        /* ====================================================================
           3. REGISTRO DE AUDITORÍA E INTEGRIDAD (/logs/{logId})
           - Contiene: Eventos de pérdida de foco, atajos y sospechas.
           - Lectura: Alumno propio y docente creador.
           - Escritura: Alumno puede añadir registros de infracción.
           ==================================================================== */
        match /logs/{logId} {
          allow read: if request.auth != null && (
            request.auth.uid == studentUid ||
            get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid
          );

          allow create: if request.auth != null &&
            request.auth.uid == studentUid;

          allow delete: if request.auth != null &&
            get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid;
        }
      }
    }

    /* ====================================================================
       4. CLAVES SECRETAS DE RESPUESTAS (/exam_keys/{examId})
       - Contiene: Mapeo de respuestas correctas { [questionId]: correctOptionIds }.
       - Seguridad Zero-Leak: ESTRICTAMENTE PROHIBIDA la lectura a los estudiantes.
       - Lectura y Escritura: ÚNICAMENTE el docente creador del examen.
       ==================================================================== */
    match /exam_keys/{examId} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.createdBy == request.auth.uid) ||
        get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid ||
        get(/databases/$(database)/documents/exams/$(examId)/submissions/$(request.auth.uid)).data.status in ['submitted', 'timed_out', 'disqualified']
      );

      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if request.auth != null && (
        (resource != null && resource.data.createdBy == request.auth.uid) ||
        get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid
      );
    }
  }
}
